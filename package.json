{
  "name": "oskalisti",
  "version": "1.0.0",
  "description": "Óskalisti fyrir gjafir – með sjálfvirkri verð- og verslanaleit",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "build:vendor": "esbuild scripts/lookup-browser-entry.js --bundle --format=esm --platform=browser --minify --legal-comments=inline --alias:cheerio=cheerio/slim --outfile=public/vendor/lookup.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
