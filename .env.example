# Afritaðu þessa skrá í .env (eða settu breyturnar inn hjá hýsingaraðila)

# Aðgangskóðinn ("developer access") sem þarf til að bæta við gjöfum og haka við keyptar gjafir.
# Ef hann er ekki settur býr síðan sjálf til kóða og skrifar hann í data/admin-code.txt og í loggið.
ADMIN_CODE=veldu-gott-leyndarord

# Valfrjálst: lykill að Claude API (https://console.anthropic.com). Þá getur síðan leitað að
# vöru eftir nafni ("KitchenAid hrærivél") á netinu og fundið verð, verslanir og mynd.
# Án lykils virkar best að líma inn hlekk á vöruna.
ANTHROPIC_API_KEY=

# Valfrjálst
PORT=3000
DATA_DIR=./data
# SESSION_SECRET=löng-handahófskennd-runa
# ANTHROPIC_MODEL=claude-opus-5-5
